# Copie para .env local se necessário (não commitar .env com secrets)
SPRING_PROFILES_ACTIVE=prod

# Neon PostgreSQL — use host com ou sem -pooler; sempre sslmode=require
# Não inclua channel_binding=require se o driver JDBC reclamar
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Alternativa (variáveis separadas)
# PGHOST=ep-xxxx.us-east-2.aws.neon.tech
# PGPORT=5432
# PGDATABASE=neondb
# PGUSER=neondb_owner
# PGPASSWORD=

ADMIN_EMAIL=neilan@estetica.com
ADMIN_PASSWORD=
