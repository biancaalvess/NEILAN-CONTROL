{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "frontend",
  "redirects": [
    {
      "source": "/",
      "destination": "/login.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://neilan-control.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://neilan-control.onrender.com/health"
    }
  ]
}
